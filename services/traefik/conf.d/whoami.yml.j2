http:
  middlewares:
    sablier-dynamic-whoami:
      plugin:
        sablier:
          names: whoami
          dynamic:
            displayName: Whoami
            refreshFrequency: 5s
            showDetails: "true"
            theme: ghost
          sablierUrl: http://sablier:10000
          sessionDuration: 1m
  services:
    whoami:
      loadBalancer:
        servers:
          - url: "http://whoami:80"
  routers:
    whoami:
      rule: PathPrefix(`/whoami`)
      entryPoints:
        - "https"
      middlewares:
        - sablier-dynamic-whoami@file
      service: "whoami"
      priority: 100
      tls:
        {% if traefik_use_self_signed %}true{% else %}certResolver: default{% endif %}
