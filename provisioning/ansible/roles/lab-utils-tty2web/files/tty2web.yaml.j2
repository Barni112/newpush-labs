http:
  routers:
    tty2web:
      service: tty2web
      rule: "Host(`tty2web.{{ lab_domain }}`)"
      entryPoints:
        - https
      tls:
{% if traefik_use_self_signed %}
        true
{% else %}
        certResolver: default
{% endif %}
      middlewares:
        - traefik-forward-auth@docker
  services:
    tty2web:
      loadBalancer:
        servers:
          - url: http://172.17.0.1:9942
